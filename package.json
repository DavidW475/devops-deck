    "keybindings": [
      {
        "command": "azureDevOps.pr.addComment",
        "key": "ctrl+alt+c",
        "mac": "cmd+alt+c",
        "when": "editorTextFocus && resourceScheme == ado-pr"
      },
      {
        "command": "azureDevOps.pr.suggestChange",
        "key": "ctrl+alt+s",
        "mac": "cmd+alt+s",
        "when": "editorTextFocus && resourceScheme == ado-pr"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "azureDevOps.refresh",
          "when": "view == azureDevOps.dashboard",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.configure",
          "when": "view == azureDevOps.dashboard",
          "group": "navigation@2"
        },
        {
          "command": "azureDevOps.signIn",
          "when": "view == azureDevOps.dashboard",
          "group": "auth@1"
        },
        {
          "command": "azureDevOps.setPat",
          "when": "view == azureDevOps.dashboard",
          "group": "auth@2"
        },
        {
          "command": "azureDevOps.watchers.create",
          "when": "view == azureDevOps.watchers",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.watchers.checkNow",
          "when": "view == azureDevOps.watchers",
          "group": "navigation@2"
        },
        {
          "command": "azureDevOps.watchers.showEvents",
          "when": "view == azureDevOps.watchers",
          "group": "more@1"
        },
        {
          "command": "azureDevOps.pr.create",
          "when": "view == azureDevOps.dashboard",
          "group": "more@1"
        },
        {
          "command": "azureDevOps.repos.open",
          "when": "view == azureDevOps.dashboard",
          "group": "more@2"
        },
        {
          "command": "azureDevOps.wiki.open",
          "when": "view == azureDevOps.dashboard",
          "group": "more@3"
        }
      ],
      "comments/commentThread/context": [
        {
          "command": "azureDevOps.pr.submitComment",
          "group": "inline",
          "when": "commentController == azureDevOps.pr"
        }
      ],
      "editor/context": [
        {
          "command": "azureDevOps.pr.addComment",
          "when": "resourceScheme == ado-pr",
          "group": "1_ado@1"
        },
        {
          "command": "azureDevOps.pr.suggestChange",
          "when": "resourceScheme == ado-pr",
          "group": "1_ado@2"
        },
        {
          "command": "azureDevOps.wi.createFromCode",
          "when": "resourceScheme == file",
          "group": "1_ado@3"
        }
      ],
      "editor/title": [
        {
          "command": "azureDevOps.pr.addComment",
          "when": "resourceScheme == ado-pr",
          "group": "navigation@1"
        },
        {
          "command": "azureDevOps.pr.suggestChange",
          "when": "resourceScheme == ado-pr",
          "group": "navigation@2"
        },
        {
          "command": "azureDevOps.pr.markReviewed",
          "when": "resourceScheme == ado-pr && !azureDevOps.fileReviewed",
          "group": "navigation@3"
        },
        {
          "command": "azureDevOps.pr.unmarkReviewed",
          "when": "resourceScheme == ado-pr && azureDevOps.fileReviewed",
          "group": "navigation@3"
        }
      ],
      "comments/comment/title": [
        {
          "command": "azureDevOps.pr.editComment",
          "group": "inline@1",
          "when": "commentController == azureDevOps.pr && comment == ado-comment-mine"
        },
        {
          "command": "azureDevOps.pr.deleteComment",
          "group": "inline@2",
          "when": "commentController == azureDevOps.pr && comment == ado-comment-mine"
        }
      ],
      "comments/comment/context": [
        {
          "command": "azureDevOps.pr.cancelEdit",
          "group": "inline@1",
          "when": "commentController == azureDevOps.pr"
        },
        {
          "command": "azureDevOps.pr.saveComment",
          "group": "inline@2",
          "when": "commentController == azureDevOps.pr"
        }
      ],
      "comments/commentThread/title": [
        {
          "command": "azureDevOps.pr.resolveThread",
          "group": "inline",
          "when": "commentController == azureDevOps.pr && commentThread == ado-thread-active"
        },
        {
          "command": "azureDevOps.pr.reactivateThread",
          "group": "inline",
          "when": "commentController == azureDevOps.pr && commentThread == ado-thread-resolved"
        }
      ],
      "commandPalette": [
