{
  "name": "devops-deck",
  "displayName": "DevOps Deck for Azure DevOps",
  "description": "Review and create pull requests, plan sprints, manage work items, watch pipelines with live logs, approve deployments and browse the wiki from inside VS Code.",
  "version": "0.2.1",
  "publisher": "davidw475",
  "license": "MIT",
  "icon": "media/icon.png",
  "repository": {
    "type": "git",
    "url": "https://github.com/DavidW475/devops-deck.git"
  },
  "bugs": {
    "url": "https://github.com/DavidW475/devops-deck/issues"
  },
  "homepage": "https://github.com/DavidW475/devops-deck#readme",
  "engines": {
    "vscode": "^1.140.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "In untrusted workspaces, organization, project, tenant, queries and watchers from workspace settings are ignored.",
      "restrictedConfigurations": [
        "azureDevOps.organization",
        "azureDevOps.project",
        "azureDevOps.additionalProjects",
        "azureDevOps.tenantId",
        "azureDevOps.workItems.queries",
        "azureDevOps.watchers"
      ]
    }
  },
  "categories": [
    "Other",
    "SCM Providers"
  ],
  "keywords": [
    "azure devops",
    "pull request",
    "work items",
    "pipelines",
    "code review",
    "sprint",
    "wiki",
    "approvals"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "azureDevOps",
          "title": "DevOps Deck",
          "icon": "media/ado.svg"
        }
      ]
    },
    "views": {
      "azureDevOps": [
        {
          "type": "webview",
          "id": "azureDevOps.dashboard",
          "name": "Dashboard",
          "icon": "media/ado.svg"
        },
        {
          "id": "azureDevOps.watchers",
          "name": "Watchers",
          "icon": "media/ado.svg"
        }
      ]
    },
    "commands": [
      {
        "command": "azureDevOps.refresh",
