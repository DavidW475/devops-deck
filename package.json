          "command": "azureDevOps.pr.openOverview",
          "when": "false"
        },
        {
          "command": "azureDevOps.pr.openDiff",
          "when": "false"
        },
        {
          "command": "azureDevOps.pr.checkout",
          "when": "false"
        },
        {
          "command": "azureDevOps.pr.openInBrowser",
          "when": "false"
        },
        {
          "command": "azureDevOps.pr.submitComment",
          "when": "false"
        },
        {
          "command": "azureDevOps.pr.resolveThread",
          "when": "false"
        },
        {
          "command": "azureDevOps.pr.reactivateThread",
          "when": "false"
        },
        {
          "command": "azureDevOps.pr.addComment",
          "when": "resourceScheme == ado-pr"
        },
        {
          "command": "azureDevOps.pr.suggestChange",
          "when": "resourceScheme == ado-pr"
        },
        {
          "command": "azureDevOps.pr.markReviewed",
          "when": "resourceScheme == ado-pr && !azureDevOps.fileReviewed"
        },
        {
          "command": "azureDevOps.pr.unmarkReviewed",
          "when": "resourceScheme == ado-pr && azureDevOps.fileReviewed"
        },
        {
          "command": "azureDevOps.pr.editComment",
          "when": "false"
        },
        {
          "command": "azureDevOps.pr.deleteComment",
          "when": "false"
        },
        {
          "command": "azureDevOps.pr.saveComment",
          "when": "false"
        },
        {
          "command": "azureDevOps.pr.cancelEdit",
          "when": "false"
        },
        {
          "command": "azureDevOps.wi.open",
          "when": "false"
        },
        {
          "command": "azureDevOps.wi.openInBrowser",
          "when": "false"
        },
        {
          "command": "azureDevOps.wi.changeState",
          "when": "false"
        },
        {
          "command": "azureDevOps.wi.assignToMe",
          "when": "false"
        },
        {
          "command": "azureDevOps.wi.comment",
          "when": "false"
        },
        {
          "command": "azureDevOps.wi.createBranch",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.rerun",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.cancel",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.openRun",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.streamLogs",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.openLog",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.openInBrowser",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.openDefinition",
          "when": "false"
        },
        {
          "command": "azureDevOps.watchers.edit",
          "when": "false"
        },
        {
          "command": "azureDevOps.watchers.pause",
          "when": "false"
        },
        {
          "command": "azureDevOps.watchers.resume",
          "when": "false"
        },
        {
          "command": "azureDevOps.watchers.delete",
          "when": "false"
        },
        {
          "command": "azureDevOps.watchers.openEvent",
          "when": "false"
        },
        {
          "command": "azureDevOps.pr.compareIterations",
          "when": "false"
        },
        {
          "command": "azureDevOps.pipelines.approve",
          "when": "false"
        },
        {
          "command": "azureDevOps.wi.createFromCode",
          "when": "editorIsOpen"
        }
      ],
      "view/item/context": [
        {
          "command": "azureDevOps.watchers.pause",
          "when": "view == azureDevOps.watchers && viewItem == watcher-enabled",
          "group": "inline@1"
        },
        {
          "command": "azureDevOps.watchers.resume",
          "when": "view == azureDevOps.watchers && viewItem == watcher-disabled",
          "group": "inline@1"
        },
        {
          "command": "azureDevOps.watchers.edit",
          "when": "view == azureDevOps.watchers && viewItem =~ /^watcher-/",
          "group": "inline@2"
        },
        {
          "command": "azureDevOps.watchers.edit",
          "when": "view == azureDevOps.watchers && viewItem =~ /^watcher-/",
          "group": "1_edit@1"
        },
        {
          "command": "azureDevOps.watchers.pause",
          "when": "view == azureDevOps.watchers && viewItem == watcher-enabled",
          "group": "1_edit@2"
        },
        {
          "command": "azureDevOps.watchers.resume",
          "when": "view == azureDevOps.watchers && viewItem == watcher-disabled",
          "group": "1_edit@2"
        },
        {
          "command": "azureDevOps.watchers.delete",
          "when": "view == azureDevOps.watchers && viewItem =~ /^watcher-/",
          "group": "9_delete@1"
        }
      ]
    },
    "configuration": {
      "title": "DevOps Deck",
      "properties": {
        "azureDevOps.organization": {
          "type": "string",
          "default": "",
          "markdownDescription": "Organization name or URL, e.g. `contoso` or `https://dev.azure.com/contoso`. Leave empty to detect it from the git remote."
        },
        "azureDevOps.project": {
          "type": "string",
          "default": "",
          "description": "Project name. Leave empty to detect it from the git remote."
        },
        "azureDevOps.additionalProjects": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "uniqueItems": true,
          "markdownDescription": "More projects of the same organization to show in the dashboard next to `azureDevOps.project`. Pull requests, work items, sprints, pipelines and approvals of all of them are listed together. Easiest to set by ticking projects in the project picker."
        },
        "azureDevOps.authMethod": {
          "type": "string",
          "enum": [
            "microsoft",
            "pat"
          ],
          "enumDescriptions": [
            "Sign in with your Microsoft (Entra ID) account via VS Code",
            "Personal Access Token stored in VS Code's secret storage"
          ],
          "default": "microsoft",
          "description": "How to authenticate against Azure DevOps."
        },
        "azureDevOps.tenantId": {
          "type": "string",
          "default": "",
          "description": "Entra ID tenant of the organization. Only needed if it differs from your account's home tenant."
        },
        "azureDevOps.workItems.queries": {
          "type": "array",
          "default": [],
          "markdownDescription": "Custom WIQL queries shown in the work item dropdown (replaces the built-in ones). Example: `{ \"name\": \"Current sprint\", \"wiql\": \"SELECT [System.Id] FROM WorkItems WHERE [System.IterationPath] = @CurrentIteration('[Project]\\\\Team')\" }`",
          "items": {
            "type": "object",
            "required": [
              "name",
              "wiql"
            ],
            "properties": {
              "name": {
                "type": "string"
              },
              "wiql": {
                "type": "string"
              }
            }
          }
        },
        "azureDevOps.refreshInterval": {
          "type": "number",
          "default": 60,
          "minimum": 0,
          "markdownDescription": "Seconds between automatic background refreshes of the visible sidebar tab. Refreshing pauses while the VS Code window is not focused and catches up when you return or switch tabs. Values below 10 are treated as 10; `0` turns automatic refresh off."
        },
        "azureDevOps.watchers": {
          "type": "array",
          "default": [],
          "markdownDescription": "Watchers check Azure DevOps in the background and run actions when work items, pull requests or pipeline runs change. See the README for examples.",
          "items": {
            "type": "object",
            "required": [
              "name",
              "type"
            ],
            "properties": {
              "name": {
                "type": "string",
                "description": "Shown in notifications"
              },
              "type": {
                "type": "string",
                "enum": [
                  "workItem",
                  "pullRequest",
                  "pipeline"
                ]
              },
              "enabled": {
                "type": "boolean",
                "default": true
              },
              "interval": {
                "type": "number",
                "default": 300,
                "minimum": 60,
                "description": "Seconds between checks (at least 60)"
              },
              "events": {
                "type": "array",
                "uniqueItems": true,
                "items": {
                  "type": "string",
                  "enum": [
                    "created",
                    "changed",
                    "pushed",
                    "voted",
                    "completed",
                    "abandoned",
                    "failed",
                    "succeeded",
                    "canceled",
                    "started"
                  ]
                },
                "markdownDescription": "Work items: `created`, `changed` (default both). Pull requests: `created` (default), `pushed`, `voted`, `completed`, `abandoned`. Pipelines: `failed` (default, includes partially succeeded), `succeeded`, `canceled`, `started`."
              },
              "where": {
                "type": "string",
                "markdownDescription": "Work items: WIQL condition, e.g. `[System.WorkItemType] = 'Bug' AND [System.AssignedTo] = @Me`"
              },
              "fields": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "markdownDescription": "Work items: only report `changed` when one of these fields changed, e.g. `[\"System.State\", \"System.AssignedTo\"]`"
              },
              "repository": {
                "type": [
                  "string",
                  "array"
                ],
                "items": {
                  "type": "string"
                },
                "description": "Pull requests: repository name(s)"
              },
              "targetBranch": {
                "type": "string",
                "markdownDescription": "Pull requests: target branch, `*` as wildcard, e.g. `release/*`"
              },
              "sourceBranch": {
                "type": "string",
                "markdownDescription": "Pull requests: source branch, `*` as wildcard"
              },
              "createdBy": {
                "type": "string",
                "markdownDescription": "Pull requests: author, `@me` or a display name / e-mail"
              },
              "reviewer": {
                "type": "string",
                "markdownDescription": "Pull requests: reviewer, `@me` or a display name / e-mail"
              },
              "titleContains": {
                "type": "string",
                "description": "Pull requests: text the title must contain"
              },
              "includeDrafts": {
                "type": "boolean",
                "default": true,
                "description": "Pull requests: also report drafts"
              },
              "pipeline": {
                "type": [
                  "string",
                  "array"
                ],
                "items": {
                  "type": "string"
                },
                "markdownDescription": "Pipelines: pipeline name(s), `*` as wildcard"
              },
              "branch": {
                "type": "string",
                "markdownDescription": "Pipelines: branch of the run, `*` as wildcard, e.g. `main` or `release/*`"
              },
              "requestedBy": {
                "type": "string",
                "markdownDescription": "Pipelines: who started the run, `@me` or a display name / e-mail"
              },
              "ignoreOwnChanges": {
                "type": "boolean",
                "description": "Skip changes you made yourself (default true; for pipelines default false)"
              },
              "actions": {
                "type": "array",
                "default": [
                  "notify"
                ],
                "items": {
                  "oneOf": [
                    {
                      "type": "string",
                      "enum": [
                        "notify",
                        "open",
                        "browser"
                      ],
                      "enumDescriptions": [
                        "Show a notification with Open / Open in Browser buttons",
                        "Open the work item or pull request in VS Code",
                        "Open it in the browser"
                      ]
                    },
                    {
                      "type": "object",
                      "required": [
                        "command"
                      ],
                      "properties": {
                        "command": {
                          "type": "string",
                          "description": "VS Code command to run once per event"
                        },
                        "args": {
                          "type": "array",
                          "description": "Arguments; ${id}, ${title}, ${url}, ${kind}, ${watcher} and ${message} are replaced"
                        }
                      },
                      "additionalProperties": false
                    }
                  ]
                },
                "description": "What to do for each event"
              }
            },
            "additionalProperties": false
          }
        },
        "azureDevOps.pipelines.refreshInterval": {
          "type": "number",
          "default": 10,
          "minimum": 5,
          "description": "Seconds between sidebar refreshes while a pipeline run is in progress."
        },
        "azureDevOps.pipelines.logPollInterval": {
          "type": "number",
          "default": 3,
          "minimum": 1,
          "description": "Seconds between polls when streaming pipeline logs."
        },
        "azureDevOps.pipelines.showTimestamps": {
          "type": "boolean",
          "default": false,
          "description": "Show timestamps in pipeline logs."
        }
      }
    },
    "viewsWelcome": [
      {
        "view": "azureDevOps.watchers",
        "contents": "Watchers check Azure DevOps in the background and notify you when work items, pull requests or pipeline runs change, for example new bugs assigned to you, pull requests waiting for your review or failed runs on main.\n[Create Watcher](command:azureDevOps.watchers.create)"
      }
    ]
  },
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "vscode:prepublish": "npm run compile",
    "package": "vsce package",
    "test": "npm run compile && node --test --enable-source-maps --require ./out/test/setup.js \"out/test/**/*.test.js\"",
    "test:coverage": "npm run compile && node -e \"require('fs').mkdirSync('coverage',{recursive:true})\" && node --test --enable-source-maps --experimental-test-coverage --test-coverage-exclude=\"out/test/**\" --require ./out/test/setup.js --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info \"out/test/**/*.test.js\""
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/vscode": "^1.140.0",
    "@vscode/vsce": "^4.0.0",
    "typescript": "^7.0.2"
  }
}
